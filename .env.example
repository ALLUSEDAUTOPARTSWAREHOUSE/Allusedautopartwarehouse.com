# GitHub OAuth for the AUAPW admin portal. Copy to a local ignored .env file.
# Set the production values in Netlify Site configuration → Environment variables.
AUAPW_PUBLIC_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated numeric GitHub account IDs that may access the admin workspace.
GITHUB_ADMIN_ALLOWED_IDS=

# Freight surcharge configuration. Confirm carrier-approved USD amounts before enabling.
# Keep the server and NEXT_PUBLIC values identical so the displayed total matches the server quote.
AUAPW_RESIDENTIAL_DELIVERY_FEE=0
AUAPW_LIFTGATE_FEE=0
NEXT_PUBLIC_AUAPW_RESIDENTIAL_DELIVERY_FEE=0
NEXT_PUBLIC_AUAPW_LIFTGATE_FEE=0
